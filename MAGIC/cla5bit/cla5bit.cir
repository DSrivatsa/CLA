* Power Supply
Vdd vdd gnd 'SUPPLY'

* Clock Signal
Vclk clk gnd pulse 0 1.8 0 0.01ns 0.01ns 0.5ns 1ns

* Test Case 1: 15 + 10 + 0 = 25
* A = 01111, B = 01010, Cin = 0
Va0_in a0_in gnd pulse 1.8 0 2ns 10ps 10ps 10ns 20ns
Va1_in a1_in gnd pulse 1.8 0 2ns 10ps 10ps 10ns 20ns
Va2_in a2_in gnd pulse 1.8 0 2ns 10ps 10ps 10ns 20ns
Va3_in a3_in gnd pulse 1.8 0 2ns 10ps 10ps 10ns 20ns
Va4_in a4_in gnd pulse 0 1.8 2ns 10ps 10ps 10ns 20ns

Vb0_in b0_in gnd pulse 0 1.8 2ns 10ps 10ps 10ns 20ns
Vb1_in b1_in gnd pulse 1.8 0 2ns 10ps 10ps 10ns 20ns
Vb2_in b2_in gnd pulse 0 1.8 2ns 10ps 10ps 10ns 20ns
Vb3_in b3_in gnd pulse 1.8 0 2ns 10ps 10ps 10ns 20ns
Vb4_in b4_in gnd pulse 0 1.8 2ns 10ps 10ps 10ns 20ns

Vc0_in c0_in gnd pulse 0 1.8 2ns 10ps 10ps 10ns 20ns

* Measurements
.measure tran tpd_rise
+ TRIG v(a0_in) VAL='0.5*SUPPLY' RISE=1
+ TARG v(s4_out) VAL='0.5*SUPPLY' RISE=1

.measure tran tpd_fall
+ TRIG v(a0_in) VAL='0.5*SUPPLY' FALL=1
+ TARG v(s4_out) VAL='0.5*SUPPLY' FALL=1

.measure tran tpd param='(tpd_rise + tpd_fall)/2'

.measure tran avg_power avg p(Vdd) from=0ns to=20ns
.measure tran peak_power max p(Vdd) from=0ns to=20ns

.tran 10ps 20ns

.control
set hcopypscolor = 1
set color0=white
set color1=black
run
set curplottitle="5bit_CLA_Magic_Verification 2025122009"

plot v(a0_in), v(a1_in)+2, v(a2_in)+4, v(a3_in)+6, v(a4_in)+8, v(clk)+10
plot v(b0_in), v(b1_in)+2, v(b2_in)+4, v(b3_in)+6, v(b4_in)+8, v(c0_in)+10, v(clk)+12
plot v(s0_out), v(s1_out)+2, v(s2_out)+4, v(s3_out)+6, v(s4_out)+8, v(c5_out)+10, v(clk)+12

print tpd avg_power peak_power
.endc

.end
